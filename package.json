{
  "name": "photo-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "pnpm": ">=12"
  },
  "description": "photo-diary — halfway between a photo album and a diary. Build days from capture dates, write a few lines, and look back through a calendar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:native-e2e": "tsc -b && vite build --mode native-e2e",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "native-e2e": "node scripts/native-e2e.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@tanstack/react-query": "^5.104.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.5.0",
    "@wdio/tauri-service": "1.5.0",
    "@wdio/types": "9.32.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
